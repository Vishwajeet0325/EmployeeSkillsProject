@model EmployeeSkillsManagement.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Edit Employee";
}

<h2>Edit Employee</h2>

<form asp-action="Edit"
      method="post">

    <input type="hidden"
           asp-for="Id" />

    <partial name="_EmployeeForm"
             model="Model" />

    <button type="submit"
            class="btn btn-primary">
        Update Employee
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}