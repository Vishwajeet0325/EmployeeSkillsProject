@model EmployeeSkillsManagement.ViewModels.EmployeeListViewModel

@{
    ViewData["Title"] = "Employees";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <h2>Employee Management</h2>

    <a asp-action="Create"
       class="btn btn-primary">
        Add Employee
    </a>

</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (!Model.Employees.Any())
{
    <div class="alert alert-info">
        No employees found.
    </div>
}
else
{
    <div class="table-responsive">

        <form asp-action="Index" method="get">

            <table class="table table-bordered table-hover">

                <thead class="table-dark">

                    <tr>
                        <th>First Name</th>
                        <th>Last Name</th>
                        <th>Date of Birth</th>
                        <th>Phone</th>
                        <th>Skills</th>
                        <th>Actions</th>
                    </tr>

                    <!-- Search Row -->
                    <tr class="table-light">

                        <th>
                            <input type="text"
                                   name="firstName"
                                   value="@ViewBag.FirstName"
                                   class="form-control"
                                   placeholder="Search First Name" />
                        </th>

                        <th>
                            <input type="text"
                                   name="lastName"
                                   value="@ViewBag.LastName"
                                   class="form-control"
                                   placeholder="Search Last Name" />
                        </th>

                        <th>
                            <input type="date"
                                   name="dateOfBirth"
                                   value="@ViewBag.DateOfBirth"
                                   class="form-control" />
                        </th>

                        <th>
                            <input type="text"
                                   name="phone"
                                   value="@ViewBag.Phone"
                                   class="form-control"
                                   placeholder="Search Phone" />
                        </th>

                        <th>
                            <input type="text"
                                   name="skill"
                                   value="@ViewBag.Skill"
                                   class="form-control"
                                   placeholder="Search Skill" />
                        </th>

                        <th>
                            <button type="submit"
                                    class="btn btn-primary btn-sm">
                                Search
                            </button>

                            <a asp-action="Index"
                               class="btn btn-secondary btn-sm mt-1">
                                Clear
                            </a>
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Employees.Any())
                    {
                        <tr>
                            <td colspan="6"
                                class="text-center">
                                No employees found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var employee in Model.Employees)
                        {
                            <tr>

                                <td>
                                    @employee.FirstName
                                </td>

                                <td>
                                    @employee.LastName
                                </td>

                                <td>
                                    @employee.DateOfBirth.ToString("dd-MM-yyyy")
                                </td>

                                <td>
                                    @employee.Phone
                                </td>

                                <td>
                                    @string.Join(", ",
                                        employee.EmployeeSkills
                                        .Select(es => es.Skill.Name))
                                </td>

                                <td>

                                    <a asp-action="Edit"
                                       asp-route-id="@employee.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@employee.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </form>

    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Employee pagination">

            <ul class="pagination justify-content-center">

                <!-- Previous -->
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage - 1)"
                           asp-route-firstName="@ViewBag.FirstName"
                           asp-route-lastName="@ViewBag.LastName"
                           asp-route-dateOfBirth="@ViewBag.DateOfBirth"
                           asp-route-phone="@ViewBag.Phone"
                           asp-route-skill="@ViewBag.Skill">
                            Previous
                        </a>

                    </li>
                }


                <!-- Page Numbers -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@i"
                           asp-route-firstName="@ViewBag.FirstName"
                           asp-route-lastName="@ViewBag.LastName"
                           asp-route-dateOfBirth="@ViewBag.DateOfBirth"
                           asp-route-phone="@ViewBag.Phone"
                           asp-route-skill="@ViewBag.Skill">

                            @i

                        </a>

                    </li>
                }


                <!-- Next -->
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-firstName="@ViewBag.FirstName"
                           asp-route-lastName="@ViewBag.LastName"
                           asp-route-dateOfBirth="@ViewBag.DateOfBirth"
                           asp-route-phone="@ViewBag.Phone"
                           asp-route-skill="@ViewBag.Skill">
                            Next
                        </a>

                    </li>
                }

            </ul>

        </nav>
    }
}