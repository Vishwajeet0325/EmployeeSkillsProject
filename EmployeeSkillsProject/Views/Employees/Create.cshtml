@model EmployeeSkillsManagement.ViewModels.EmployeeViewModel

@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>

<form asp-action="Create"
      method="post">

    <partial name="_EmployeeForm"
             model="Model" />

    <button type="submit"
            class="btn btn-primary">
        Save Employee
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}